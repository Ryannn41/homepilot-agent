HOMEPILOT_HOST=0.0.0.0
HOMEPILOT_PORT=8000
# 客户端需在 HOMEPILOT_AUTH_TOKEN 中配置相同的值；留空不校验
HOMEPILOT_AUTH_TOKEN=

HOMEPILOT_DASHSCOPE_API_KEY=sk-xxx
HOMEPILOT_ASR_MODEL=paraformer-realtime-v2
HOMEPILOT_TTS_MODEL=cosyvoice-v2
HOMEPILOT_TTS_VOICE=longxiaochun_v2

HOMEPILOT_DEEPSEEK_API_KEY=sk-xxx
HOMEPILOT_DEEPSEEK_MODEL=deepseek-flash

HOMEPILOT_TIMEZONE=Asia/Shanghai
HOMEPILOT_HOME_CITY=上海
HOMEPILOT_SEARCH_MODEL=qwen-flash

HOMEPILOT_LOG_LEVEL=INFO
